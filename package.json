{
  "name": "tailwind-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Model Context Protocol server exposing the real Tailwind CSS engine: exact class list, theme values, generated CSS and canonical order",
  "type": "module",
  "license": "MIT",
  "author": "Vitaly Kuzyaev <vitkuz573@gmail.com>",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tailwind",
    "tailwindcss",
    "css",
    "design-tokens",
    "llm"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "tailwind-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "inspect": "npx --yes @modelcontextprotocol/inspector dist/index.js",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run format:check && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.9",
    "tailwindcss": "4.3.3",
    "tailwindcss-v3": "npm:tailwindcss@3.4.17",
    "typescript": "^5.9.0",
    "vitest": "5.0.2"
  }
}
